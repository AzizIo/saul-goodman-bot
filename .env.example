# Токен бота от @BotFather
BOT_TOKEN=123456:AAExampleTokenReplaceMe

# Telegram ID администратора (узнать: @userinfobot)
ADMIN_ID=100000000

# Канал для проверки подписки: числовой ID (-100...) или @username
CHANNEL_ID=@example_channel
CHANNEL_LINK=https://t.me/example_channel
CHANNEL_TITLE=наше сообщество

# Минимальная сумма к выводу, в долларах
MIN_WITHDRAWAL=1.00

# Пути (по умолчанию data/saul.db и data/qr)
DB_PATH=data/saul.db
QR_DIR=data/qr

# Хранить файлы QR на диске (по умолчанию выключено — только file_id Telegram)
QR_STORE_FILES=false
QR_RETENTION_DAYS=7

LOG_LEVEL=INFO